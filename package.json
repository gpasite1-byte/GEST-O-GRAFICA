{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; true'",
    "build": "pnpm --filter @workspace/grafica-flow run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "build:all": "pnpm run typecheck && pnpm -r --if-present run build"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@rollup/rollup-win32-x64-msvc": "^4.64.1",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "@types/pg": "^8.23.1"
  },
  "type": "module"
}
